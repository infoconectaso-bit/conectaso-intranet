# Copia este archivo a  .env.restore  y rellena las claves de Backblaze (basta permiso de LECTURA).
# Estos datos salen de tu cuenta de Backblaze (bucket conectaso-backups). NO los subas a GitHub:
# .env.restore está en .gitignore.

B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET=conectaso-backups
B2_REGION=eu-central-003
B2_KEY_ID=pon-aqui-el-keyID
B2_APP_KEY=pon-aqui-el-applicationKey
