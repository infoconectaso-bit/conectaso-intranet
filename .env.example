# ---------------------------------------------------------------------------
# Configuración del Gestor de eventos de Conecta So
# Copia este archivo a ".env" y ajusta los valores.
# ---------------------------------------------------------------------------

# Puerto donde escucha la aplicación.
PORT=3000

# Dirección pública completa (sin barra final). Se usa para construir los
# enlaces de invitación y de recuperación de contraseña que se envían por email.
# Ejemplo en producción: https://intranet.conectaso.es
APP_URL=http://localhost:3000

# Carpeta de datos (base de datos SQLite + archivos subidos).
# Con Docker se deja en /data (montado como volumen). En instalación manual,
# por defecto es ./data dentro del proyecto.
# DATA_DIR=/data

# Días que dura la sesión iniciada (cookie). Por defecto 14.
SESSION_DAYS=14

# Tamaño máximo por archivo subido a un evento, en MB. Por defecto 25.
MAX_UPLOAD_MB=25

# Si la aplicación está detrás de un proxy inverso (nginx, Caddy, Traefik…)
# que gestiona HTTPS, pon esto a true para que lea la IP real y marque la
# cookie como segura.
# TRUST_PROXY=true
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Correo (opcional). Si lo configuras, las invitaciones y los enlaces de
# recuperación de contraseña se envían automáticamente por email. Si lo dejas
# vacío, la aplicación mostrará el enlace en pantalla para que lo compartas tú.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.tucorreo.com
# SMTP_PORT=587
# SMTP_USER=gestor@conectaso.es
# SMTP_PASS=
# MAIL_FROM=gestor@conectaso.es
